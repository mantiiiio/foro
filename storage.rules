rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.uid in ['PEGA_AQUI_TU_UID_ADMIN'];
    }
    function isModerator() {
      return signedIn() && request.auth.uid in ['PEGA_AQUI_TU_UID_MODERADOR'];
    }
    function isStaff() { return isAdmin() || isModerator(); }

    match /chat/{uid}/{fileName} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == uid
        && (
          (request.resource.contentType.matches('image/(jpeg|png|gif|webp)')
            && request.resource.size <= 8 * 1024 * 1024)
          ||
          (request.resource.contentType.matches('video/(mp4|webm)')
            && request.resource.size <= 25 * 1024 * 1024)
        );
      allow update: if false;
      allow delete: if isStaff() || (signedIn() && request.auth.uid == uid);
    }

    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp)')
        && request.resource.size <= 5 * 1024 * 1024;
      allow update: if false;
      allow delete: if isStaff() || (signedIn() && request.auth.uid == uid);
    }
  }
}