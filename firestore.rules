rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.uid == 'YgTAVFNclBgScVybW82xE0jKJg32'; }
    function hasStaffRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == role;
    }
    function isAdmin() { return isOwner() || hasStaffRole('co_owner') || hasStaffRole('admin'); }
    function isModerator() { return isAdmin() || hasStaffRole('moderator'); }
    function isStaff() { return isModerator(); }
    function canManageStaff() { return isAdmin(); }
    function canIssueStaffRole(role) {
      return (isOwner() && role in ['co_owner','admin','moderator','helper'])
        || (isAdmin() && !isOwner() && role in ['moderator','helper']);
    }
    function canManageInviteRole(role) {
      return isOwner() || (isAdmin() && role in ['moderator','helper']);
    }
    function registered() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function verifiedMember() {
      return registered() && request.auth.token.email_verified == true;
    }
    function moderationPath(uid) {
      return /databases/$(database)/documents/moderation/$(uid);
    }
    function hasFreshChatRateLimit(uid, messageId) {
      let path = /databases/$(database)/documents/userRateLimits/$(uid);
      return existsAfter(path)
        && getAfter(path).data.lastChatAt == request.time
        && getAfter(path).data.lastChatMessageId == messageId;
    }
    function hasFreshPostRateLimit(uid, postId) {
      let path = /databases/$(database)/documents/userRateLimits/$(uid);
      return existsAfter(path)
        && getAfter(path).data.lastPostAt == request.time
        && getAfter(path).data.lastPostId == postId;
    }
    function canParticipate() {
      return signedIn() && (
        isOwner()
        || !exists(moderationPath(request.auth.uid))
        || get(moderationPath(request.auth.uid)).data.get('status', 'active') == 'active'
        || (
          get(moderationPath(request.auth.uid)).data.get('status', 'active') == 'temporary'
          && get(moderationPath(request.auth.uid)).data.get('banUntil', request.time) is timestamp
          && get(moderationPath(request.auth.uid)).data.banUntil <= request.time
        )
      );
    }
    function canModerateTarget(uid) {
      return isStaff()
        && uid != request.auth.uid
        && uid != 'YgTAVFNclBgScVybW82xE0jKJg32'
        && (!exists(/databases/$(database)/documents/staff/$(uid)) || isAdmin());
    }
    function validAutoWarningEntry(entry, uid) {
      return entry is map
        && entry.keys().hasOnly(['reason','code','channel','source','actorUid','actorName','at'])
        && entry.reason is string
        && entry.reason.size() >= 1
        && entry.reason.size() <= 240
        && entry.code in ['threat','harassment','link_spam','duplicate','flood','caps','repeated']
        && entry.channel in ['chat','tema','comentario']
        && entry.source == 'automod'
        && entry.actorUid == uid
        && entry.actorName == 'AutoModeración'
        && entry.at is int;
    }
    function validAutoWarningCreate(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['warnings','warningCount','status','banUntil','banReason','updatedAt','lastActionBy'])
        && request.resource.data.warnings is list
        && request.resource.data.warnings.size() == 1
        && request.resource.data.warningCount == 1
        && validAutoWarningEntry(request.resource.data.warnings[0], uid)
        && request.resource.data.status == 'active'
        && request.resource.data.banUntil == null
        && request.resource.data.banReason == ''
        && request.resource.data.updatedAt is int
        && request.resource.data.lastActionBy == 'automod';
    }
    function validAutoWarningUpdate(uid) {
      let oldCount = resource.data.get('warningCount', 0);
      return signedIn()
        && request.auth.uid == uid
        && oldCount is int
        && oldCount >= 0
        && oldCount < 3
        && resource.data.get('status', 'active') != 'permanent'
        && (resource.data.get('status', 'active') == 'active' || (resource.data.get('status', 'active') == 'temporary' && resource.data.get('banUntil', request.time) is timestamp && resource.data.banUntil <= request.time))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['warnings','warningCount','status','banUntil','banReason','updatedAt','lastActionBy'])
        && request.resource.data.warnings is list
        && request.resource.data.warnings.size() == oldCount + 1
        && request.resource.data.warningCount == oldCount + 1
        && validAutoWarningEntry(request.resource.data.warnings[oldCount], uid)
        && (oldCount < 1 || request.resource.data.warnings[0] == resource.data.warnings[0])
        && (oldCount < 2 || request.resource.data.warnings[1] == resource.data.warnings[1])
        && request.resource.data.updatedAt is int
        && request.resource.data.lastActionBy == 'automod'
        && (
          (request.resource.data.warningCount == 3
            && request.resource.data.status == 'permanent'
            && request.resource.data.banUntil == null
            && request.resource.data.banReason == 'Tres avisos automáticos')
          || (
            request.resource.data.warningCount < 3
            && request.resource.data.status == resource.data.get('status', 'active')
            && request.resource.data.banUntil == resource.data.get('banUntil', null)
            && request.resource.data.banReason == resource.data.get('banReason', '')
          )
        );
    }
    function validModerationEntry(entry) {
      return entry is map
        && entry.keys().hasOnly(['reason','code','channel','source','actorUid','actorName','at'])
        && entry.reason is string
        && entry.reason.size() >= 1
        && entry.reason.size() <= 240
        && entry.source in ['automod','staff']
        && entry.actorUid is string
        && entry.actorName is string
        && entry.at is int
        && (
          (entry.source == 'automod'
            && entry.code in ['threat','harassment','link_spam','duplicate','flood','caps','repeated']
            && entry.channel in ['chat','tema','comentario'])
          || entry.source == 'staff'
        );
    }
    function validModerationRecord() {
      return request.resource.data.keys().hasOnly(['warnings','warningCount','status','banUntil','banReason','updatedAt','lastActionBy'])
        && request.resource.data.warnings is list
        && request.resource.data.warnings.size() <= 3
        && (request.resource.data.warnings.size() < 1 || validModerationEntry(request.resource.data.warnings[0]))
        && (request.resource.data.warnings.size() < 2 || validModerationEntry(request.resource.data.warnings[1]))
        && (request.resource.data.warnings.size() < 3 || validModerationEntry(request.resource.data.warnings[2]))
        && request.resource.data.warningCount is int
        && request.resource.data.warningCount == request.resource.data.warnings.size()
        && request.resource.data.status in ['active','temporary','permanent']
        && (request.resource.data.banUntil == null || request.resource.data.banUntil is timestamp)
        && request.resource.data.banReason is string
        && request.resource.data.banReason.size() <= 240
        && request.resource.data.updatedAt is int
        && request.resource.data.lastActionBy is string
        && (request.resource.data.warningCount != 3 || request.resource.data.status == 'permanent')
        && (request.resource.data.status != 'permanent' || isAdmin() || request.resource.data.warningCount == 3)
        && (
          request.resource.data.status != 'temporary'
          || request.resource.data.banUntil is timestamp
        )
        && (
          request.resource.data.status != 'active'
          || request.resource.data.banUntil == null
        );
    }
    function validModerationUpdate() {
      let oldCount = resource.data.get('warningCount', 0);
      return validModerationRecord()
        && (
          isAdmin()
          || (
            oldCount is int
            && request.resource.data.warningCount >= oldCount
            && request.resource.data.warningCount <= oldCount + 1
            && (oldCount < 1 || request.resource.data.warnings[0] == resource.data.warnings[0])
            && (oldCount < 2 || request.resource.data.warnings[1] == resource.data.warnings[1])
            && (oldCount < 3 || request.resource.data.warnings[2] == resource.data.warnings[2])
            && (resource.data.get('status', 'active') != 'permanent' || request.resource.data.status == 'permanent')
            && (resource.data.get('status', 'active') != 'temporary' || request.resource.data.status != 'active')
          )
        );
    }
    function shortString(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }
    function containsLink(value) {
      return value.matches('(?s).*(https?://|www\\.).*');
    }
    // Filtro adicional en servidor para amenazas explícitas e insultos dirigidos.
    function automodSafe(value) {
      return value is string
        && !value.matches('(?is).*(te voy a matar|voy a matarte|te voy a pegar|voy a golpearte|ojala te mueras|ojalá te mueras|i will kill you|i am going to kill you|sos un idiota|eres un idiota|sois un idiota|sos un imbecil|eres un imbecil|sos un imbécil|eres un imbécil|sos un retrasado|eres un retrasado).*')
        && !value.matches('(?is).*(https?://.*https?://.*https?://.*https?://|www\\..*www\\..*www\\..*www\\.).*')
        && !value.matches('(?s)^(?:[^a-záéíóúüñ]*[A-ZÁÉÍÓÚÜÑ]){28,}[^a-záéíóúüñ]*$');
    }
    function validChatMedia(media) {
      return media is map
        && media.keys().hasOnly(['url','path','type','name','size'])
        && media.url is string
        && media.url.matches('https://.*')
        && media.path is string
        && media.path.size() <= 300
        && media.type is string
        && media.type.matches('(image/(jpeg|png|gif|webp)|video/(mp4|webm)|application/(pdf|zip|x-zip-compressed)|text/(plain|csv))')
        && media.name is string
        && media.name.size() > 0
        && media.name.size() <= 120
        && media.size is int
        && media.size > 0
        && media.size <= 25 * 1024 * 1024;
    }

    match /userRateLimits/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && (
          (
            request.resource.data.keys().hasOnly(['lastChatAt','lastChatMessageId'])
            && request.resource.data.lastChatAt == request.time
            && request.resource.data.lastChatMessageId is string
            && request.resource.data.lastChatMessageId.size() > 0
            && request.resource.data.lastChatMessageId.size() <= 150
          )
          || (
            request.resource.data.keys().hasOnly(['lastPostAt','lastPostId'])
            && request.resource.data.lastPostAt == request.time
            && request.resource.data.lastPostId is string
            && request.resource.data.lastPostId.size() > 0
            && request.resource.data.lastPostId.size() <= 150
          )
        );
      allow update: if signedIn()
        && request.auth.uid == uid
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastChatAt','lastChatMessageId'])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll(['lastChatAt','lastChatMessageId'])
            && (!('lastChatAt' in resource.data) || (resource.data.lastChatAt is timestamp && resource.data.lastChatAt + duration.value(2, 's') <= request.time))
            && request.resource.data.lastChatAt == request.time
            && request.resource.data.lastChatMessageId is string
            && request.resource.data.lastChatMessageId.size() > 0
            && request.resource.data.lastChatMessageId.size() <= 150
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastPostAt','lastPostId'])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll(['lastPostAt','lastPostId'])
            && (!('lastPostAt' in resource.data) || (resource.data.lastPostAt is timestamp && resource.data.lastPostAt + duration.value(3, 's') <= request.time))
            && request.resource.data.lastPostAt == request.time
            && request.resource.data.lastPostId is string
            && request.resource.data.lastPostId.size() > 0
            && request.resource.data.lastPostId.size() <= 150
          )
        );
      allow delete: if false;
    }

    match /moderation/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isStaff());
      allow list: if isStaff();
      allow create: if (canModerateTarget(uid) && validModerationRecord()) || validAutoWarningCreate(uid);
      allow update: if (canModerateTarget(uid) && validModerationUpdate()) || validAutoWarningUpdate(uid);
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if registered()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['u', 'ts', 'rulesAcceptedAt'])
        && shortString(request.resource.data.u, 16)
        && request.resource.data.ts is int
        && request.resource.data.rulesAcceptedAt is int
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.u))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.u)).data.uid == request.auth.uid;
      allow update: if (
        registered()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl', 'avatarPath'])
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 2048
        && request.resource.data.avatarPath is string
        && request.resource.data.avatarPath.size() <= 300
        && (
          (request.resource.data.avatarUrl == '' && request.resource.data.avatarPath == '')
          || (
            request.resource.data.avatarUrl.matches('https://firebasestorage.googleapis.com/.*')
            && request.resource.data.avatarPath.matches('avatars/.*')
          )
          || (
            request.resource.data.avatarUrl.matches('https://.*')
            && request.resource.data.avatarPath == ''
          )
        )
      );
      allow delete: if isAdmin();
    }

    // Reserva pública del nombre de usuario; nunca almacena el correo privado.
    match /usernames/{username} {
      allow read: if true;
      allow create: if registered()
        && request.resource.data.keys().hasOnly(['u', 'uid', 'ts'])
        && request.resource.data.u == username
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts is int
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.u == username;
      allow update, delete: if isAdmin();
    }


    // El sistema anterior de tokens genéricos quedó retirado permanentemente.
    match /accessTokens/{tokenHash} {
      allow read, write: if false;
    }

    // Roles persistentes: nadie puede otorgarse un rol sin una invitación válida.
    match /staff/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isStaff());
      allow list: if canManageStaff();
      allow create: if verifiedMember()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role','grantedAt','grantedBy','inviteHash'])
        && request.resource.data.role in ['co_owner','admin','moderator','helper']
        && request.resource.data.grantedAt is timestamp
        && request.resource.data.grantedBy is string
        && request.resource.data.inviteHash is string
        && existsAfter(/databases/$(database)/documents/staffInvites/$(request.resource.data.inviteHash))
        && getAfter(/databases/$(database)/documents/staffInvites/$(request.resource.data.inviteHash)).data.status == 'used'
        && getAfter(/databases/$(database)/documents/staffInvites/$(request.resource.data.inviteHash)).data.claimedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/staffInvites/$(request.resource.data.inviteHash)).data.role == request.resource.data.role
        && getAfter(/databases/$(database)/documents/staffInvites/$(request.resource.data.inviteHash)).data.createdBy == request.resource.data.grantedBy;
      allow update: if false;
      allow delete: if isOwner() || (isAdmin() && resource.data.role in ['moderator','helper']);
    }

    // Solo el personal administrador emite invitaciones. El ID del documento es SHA-256 del código.
    match /staffInvites/{tokenHash} {
      allow get: if signedIn();
      allow list: if canManageStaff();
      allow create: if canIssueStaffRole(request.resource.data.role)
        && request.resource.data.keys().hasOnly(['role','description','status','createdBy','createdAt','expiresAt'])
        && request.resource.data.role in ['co_owner','admin','moderator','helper']
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 3
        && request.resource.data.description.size() <= 140
        && request.resource.data.status == 'available'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
      allow update: if (
        verifiedMember()
        && resource.data.status == 'available'
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','claimedBy','claimedAt'])
        && request.resource.data.status == 'used'
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.claimedAt == request.time
        && existsAfter(/databases/$(database)/documents/staff/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/staff/$(request.auth.uid)).data.inviteHash == tokenHash
        && getAfter(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == resource.data.role
      ) || (
        canManageInviteRole(resource.data.role)
        && resource.data.status == 'available'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revokedBy','revokedAt'])
        && request.resource.data.status == 'revoked'
        && request.resource.data.revokedBy == request.auth.uid
        && request.resource.data.revokedAt == request.time
      );
      allow delete: if false; // Registro permanente: una invitación usada o revocada nunca se elimina.
    }

    match /topics/{topicId} {
      allow read: if canParticipate();
      allow create: if verifiedMember()
        && canParticipate()
        && request.resource.data.keys().hasOnly(['b','t','u','uid','ts','lr','lu','n'])
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.u == request.resource.data.u
        && shortString(request.resource.data.b, 24)
        && shortString(request.resource.data.t, 100)
        && automodSafe(request.resource.data.t)
        && shortString(request.resource.data.u, 16)
        && request.resource.data.n == 0
        && request.resource.data.ts is int
        && request.resource.data.lr is int
        && (request.resource.data.b != 'reglas' || isStaff());
      allow update: if isAdmin() || (
        isModerator()
        && resource.data.b != 'reglas'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && resource.data.n > 0
        && request.resource.data.n == resource.data.n - 1
      ) || (
        verifiedMember()
        && canParticipate()
        && resource.data.b != 'reglas'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lr','lu','n'])
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.lr is int
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.lu == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.u
        && shortString(request.resource.data.lu, 16)
      ) || (
        registered()
        && resource.data.b != 'reglas'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && resource.data.n > 0
        && request.resource.data.n == resource.data.n - 1
      );
      allow delete: if isStaff() || (
        registered()
        && resource.data.uid == request.auth.uid
        && resource.data.b != 'reglas'
      );

      match /ratings/{ratingUid} {
        allow read: if canParticipate();
        allow create: if registered()
          && canParticipate()
          && request.auth.uid == ratingUid
          && get(/databases/$(database)/documents/topics/$(topicId)).data.b != 'reglas'
          && request.resource.data.keys().hasOnly(['uid','stars','ts'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5
          && request.resource.data.ts is int;
        allow update: if registered()
          && canParticipate()
          && request.auth.uid == ratingUid
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stars','ts'])
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5
          && request.resource.data.ts is int;
        allow delete: if isAdmin() || (registered() && request.auth.uid == ratingUid);
      }
    }

    match /posts/{postId} {
      allow read: if canParticipate();
      allow create: if verifiedMember()
        && canParticipate()
        && hasFreshPostRateLimit(request.auth.uid, postId)
        && request.resource.data.keys().hasOnly(['tp','u','uid','x','ts'])
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.u == request.resource.data.u
        && shortString(request.resource.data.tp, 200)
        && shortString(request.resource.data.u, 16)
        && request.resource.data.x is string
        && request.resource.data.x.size() > 0
        && request.resource.data.x.size() <= 6000
        && automodSafe(request.resource.data.x)
        && request.resource.data.ts is int
        && existsAfter(/databases/$(database)/documents/topics/$(request.resource.data.tp))
        && (getAfter(/databases/$(database)/documents/topics/$(request.resource.data.tp)).data.b != 'reglas' || isStaff());
      allow update: if isStaff() || (
        verifiedMember()
        && canParticipate()
        && resource.data.uid == request.auth.uid
        && resource.data.get('deleted', false) != true
        && get(/databases/$(database)/documents/topics/$(resource.data.tp)).data.b != 'reglas'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x'])
        && request.resource.data.x is string
        && request.resource.data.x.size() > 0
        && request.resource.data.x.size() <= 6000
        && automodSafe(request.resource.data.x)
      ) || (
        registered()
        && resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/topics/$(resource.data.tp)).data.b != 'reglas'
        && resource.data.get('deleted', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x','deleted','deletedBy','deletedByUid','deletedAt','deletedQuoteHash'])
        && request.resource.data.x == ''
        && request.resource.data.deleted == true
        && request.resource.data.deletedBy == 'usuario'
        && request.resource.data.deletedByUid == request.auth.uid
        && request.resource.data.deletedAt is int
        && request.resource.data.deletedQuoteHash is string
        && request.resource.data.deletedQuoteHash.size() <= 16
      );
      allow delete: if isStaff() || (
        registered()
        && get(/databases/$(database)/documents/topics/$(resource.data.tp)).data.b != 'reglas'
        && (
          resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/topics/$(resource.data.tp)).data.uid == request.auth.uid
        )
      );
    }

    match /chatMessages/{messageId} {
      allow read: if canParticipate();
      allow create: if signedIn()
        && canParticipate()
        && hasFreshChatRateLimit(request.auth.uid, messageId)
        && request.resource.data.keys().hasOnly(['uid','u','avatarUrl','x','media','ts'])
        && request.resource.data.uid == request.auth.uid
        && shortString(request.resource.data.u, 32)
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 2048
        && request.resource.data.x is string
        && request.resource.data.x.size() <= 1500
        && automodSafe(request.resource.data.x)
        && request.resource.data.ts is int
        && (
          (request.auth.token.firebase.sign_in_provider == 'anonymous'
            && request.resource.data.u.matches('Invitado-[A-Z0-9]{5}')
            && request.resource.data.avatarUrl == '')
          ||
          (request.auth.token.firebase.sign_in_provider != 'anonymous'
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.u == request.resource.data.u
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('avatarUrl', '') == request.resource.data.avatarUrl)
        )
        && (request.resource.data.x.size() > 0 || request.resource.data.media is map)
        && (request.resource.data.media == null || validChatMedia(request.resource.data.media))
        && (!containsLink(request.resource.data.x) || registered());
      allow update: if (
        signedIn()
        && canParticipate()
        && resource.data.uid == request.auth.uid
        && resource.data.get('deleted', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x'])
        && request.resource.data.x is string
        && request.resource.data.x.size() <= 1500
        && automodSafe(request.resource.data.x)
        && (request.resource.data.x.size() > 0 || resource.data.media is map)
        && (!containsLink(request.resource.data.x) || registered())
      ) || (
        signedIn()
        && (isAdmin() || resource.data.uid == request.auth.uid)
        && resource.data.get('deleted', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x','media','deleted','deletedBy','deletedAt','deletedByUid'])
        && request.resource.data.x == ''
        && request.resource.data.media == null
        && request.resource.data.deleted == true
        && request.resource.data.deletedBy == (isAdmin() ? 'administrador' : 'usuario')
        && request.resource.data.deletedAt is int
        && request.resource.data.deletedByUid == request.auth.uid
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}