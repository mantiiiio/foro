rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.uid in ['PEGA_AQUI_TU_UID_ADMIN'];
    }
    function registered() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function verifiedMember() {
      return registered() && request.auth.token.email_verified == true;
    }
    function shortString(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if registered()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['u', 'ts'])
        && shortString(request.resource.data.u, 16)
        && request.resource.data.ts is int;
      allow update: if isAdmin() || (
        registered()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl', 'avatarPath'])
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 2048
        && request.resource.data.avatarPath is string
        && request.resource.data.avatarPath.size() <= 300
        && (
          (request.resource.data.avatarUrl == '' && request.resource.data.avatarPath == '')
          || (
            request.resource.data.avatarUrl.matches('https://firebasestorage.googleapis.com/.*')
            && request.resource.data.avatarPath.matches('avatars/.*')
          )
        )
      );
      allow delete: if isAdmin();
    }

    // Reserva pública del nombre de usuario; nunca almacena el correo privado.
    match /usernames/{username} {
      allow read: if true;
      allow create: if registered()
        && request.resource.data.keys().hasOnly(['u', 'uid', 'ts'])
        && request.resource.data.u == username
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts is int
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.u == username;
      allow update, delete: if isAdmin();
    }

    match /topics/{topicId} {
      allow read: if true;
      allow create: if verifiedMember()
        && request.resource.data.keys().hasOnly(['b','t','u','uid','ts','lr','lu','n'])
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.u == request.resource.data.u
        && shortString(request.resource.data.b, 24)
        && shortString(request.resource.data.t, 100)
        && shortString(request.resource.data.u, 16)
        && request.resource.data.n == 0
        && request.resource.data.ts is int
        && request.resource.data.lr is int
        && (request.resource.data.b != 'reglas' || isAdmin());
      allow update: if isAdmin() || (
        verifiedMember()
        && resource.data.b != 'reglas'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lr','lu','n'])
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.lr is int
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.lu == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.u
        && shortString(request.resource.data.lu, 16)
      );
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if verifiedMember()
        && request.resource.data.keys().hasOnly(['tp','u','uid','x','ts'])
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.u == request.resource.data.u
        && shortString(request.resource.data.tp, 200)
        && shortString(request.resource.data.u, 16)
        && request.resource.data.x is string
        && request.resource.data.x.size() > 0
        && request.resource.data.x.size() <= 6000
        && request.resource.data.ts is int
        && existsAfter(/databases/$(database)/documents/topics/$(request.resource.data.tp))
        && (getAfter(/databases/$(database)/documents/topics/$(request.resource.data.tp)).data.b != 'reglas' || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /chatMessages/{messageId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','u','avatarUrl','x','media','ts'])
        && request.resource.data.uid == request.auth.uid
        && shortString(request.resource.data.u, 32)
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 2048
        && request.resource.data.x is string
        && request.resource.data.x.size() <= 1500
        && request.resource.data.ts is int
        && (
          (request.auth.token.firebase.sign_in_provider == 'anonymous'
            && request.resource.data.u.matches('Invitado-[A-Z0-9]{5}')
            && request.resource.data.avatarUrl == '')
          ||
          (request.auth.token.firebase.sign_in_provider != 'anonymous'
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.u == request.resource.data.u
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('avatarUrl', '') == request.resource.data.avatarUrl)
        )
        && (request.resource.data.x.size() > 0 || request.resource.data.media is map);
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}